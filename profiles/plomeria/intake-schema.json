{
  "$businessName": "{{businessName}}",
  "$businessDomain": "{{businessDomain}}",
  "$language": "es-MX",
  "sections": [
    {
      "key": "client",
      "label": "Cliente",
      "fields": [
        { "key": "name", "label": "Nombre", "type": "string", "required": true },
        { "key": "city_or_zone", "label": "Ciudad / Zona", "type": "string", "required": true },
        { "key": "phone_alt", "label": "Teléfono alterno", "type": "phone", "required": false }
      ]
    },
    {
      "key": "work",
      "label": "Problema",
      "fields": [
        { "key": "problem_type", "label": "Tipo de problema", "type": "enum", "required": true, "options": ["fuga de agua", "destape", "instalación nueva", "calentador", "otro"] },
        { "key": "location_in_house", "label": "Zona del inmueble", "type": "string", "required": false, "hint": "Ej. baño, cocina, azotea, tinaco, jardín" },
        { "key": "urgency", "label": "¿Es urgente?", "type": "boolean", "required": false, "hint": "Indica si hay riesgo de inundación o corte de agua" },
        { "key": "photos", "label": "Fotos del problema", "type": "boolean", "required": false, "hint": "¿puede enviar fotos? si no puede o no quiere, declina con update_intake declined=true" }
      ]
    },
    {
      "key": "logistics",
      "label": "Logística",
      "fields": [
        { "key": "address", "label": "Dirección", "type": "text", "required": false },
        { "key": "desired_time", "label": "Horario preferido", "type": "string", "required": false }
      ]
    }
  ]
}

{
  "$businessName": "{{businessName}}",
  "$businessDomain": "{{businessDomain}}",
  "$language": "es-MX",
  "sections": [
    {
      "use": "customer.identity"
    },
    {
      "key": "work",
      "label": "Servicio",
      "fields": [
        {
          "key": "problem_type",
          "label": "Tipo de problema",
          "type": "enum",
          "required": true,
          "options": [
            "instalación eléctrica",
            "cortocircuito",
            "apagón parcial",
            "tablero o centro de carga",
            "otro"
          ]
        },
        {
          "key": "property_type",
          "label": "Tipo de inmueble",
          "type": "enum",
          "required": false,
          "options": [
            "casa habitación",
            "departamento",
            "local comercial",
            "oficina",
            "otro"
          ]
        },
        {
          "key": "symptom",
          "label": "Descripción del problema",
          "type": "text",
          "required": false,
          "hint": "Ej. se fue la luz en un cuarto, apaga el switch y salta el breaker, necesito instalar un contacto"
        },
        {
          "key": "photos",
          "label": "Fotos del tablero o zona afectada",
          "type": "boolean",
          "required": false,
          "hint": "¿puede enviar fotos? si no puede o no quiere, declina con update_intake declined=true"
        }
      ]
    },
    {
      "use": "service.logistics"
    }
  ]
}

{
  "$businessName": "{{businessName}}",
  "$businessDomain": "{{businessDomain}}",
  "$language": "es-MX",
  "sections": [
    {
      "use": "customer.identity"
    },
    {
      "key": "work",
      "label": "Equipo y servicio",
      "fields": [
        {
          "key": "equipment_type",
          "label": "Tipo de equipo",
          "type": "enum",
          "required": true,
          "options": [
            "refrigerador",
            "minisplit",
            "aire central",
            "cámara frigorífica",
            "otro"
          ]
        },
        {
          "key": "brand",
          "label": "Marca del equipo",
          "type": "string",
          "required": false,
          "hint": "Ej. Mabe, LG, Samsung, Carrier, Trane"
        },
        {
          "key": "symptom",
          "label": "Síntoma / falla",
          "type": "text",
          "required": true,
          "hint": "Ej. no enfría, gotea agua, hace ruido fuerte, no enciende"
        },
        {
          "key": "photos",
          "label": "Fotos del equipo",
          "type": "boolean",
          "required": false,
          "hint": "¿puede enviar fotos? si no puede o no quiere, declina con update_intake declined=true"
        }
      ]
    },
    {
      "use": "service.logistics"
    }
  ]
}

{
  "$businessName": "{{businessName}}",
  "$businessDomain": "{{businessDomain}}",
  "$language": "es-MX",
  "sections": [
    {
      "use": "customer.identity"
    },
    {
      "key": "work",
      "label": "Servicio",
      "fields": [
        {
          "key": "service_type",
          "label": "Tipo de servicio",
          "type": "enum",
          "required": true,
          "options": [
            "apertura de emergencia",
            "cambio de cerradura",
            "copia de llave",
            "chapa de auto",
            "otro"
          ]
        },
        {
          "key": "door_lock_type",
          "label": "Tipo de puerta / cerradura",
          "type": "string",
          "required": false,
          "hint": "Ej. puerta principal madera, cerradura de pomo, puerta de metal, caja fuerte"
        },
        {
          "key": "urgency",
          "label": "¿Es urgente?",
          "type": "boolean",
          "required": false,
          "hint": "Indícalo si el cliente está bloqueado o en situación de emergencia"
        },
        {
          "key": "photos",
          "label": "Fotos de la cerradura o puerta",
          "type": "boolean",
          "required": false,
          "hint": "¿puede enviar foto? si no quiere o no puede, declina con update_intake declined=true"
        }
      ]
    },
    {
      "use": "service.logistics",
      "labels": {
        "address": "Dirección exacta"
      }
    }
  ]
}
